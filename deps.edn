{:paths ["src"]
 ;; langgraph brings langchain transitively (both zero-/single-dep, all
 ;; .cljc → portable to JVM / SCI / ClojureScript / GraalVM). Both live in
 ;; the kotoba-lang org of this workspace (kotoba wasm → clojurewasm →
 ;; ClojureScript → nbb runtime priority, CLAUDE.md).
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       io.github.kotoba-lang/jp-go-digital-design-system
        {:git/url "https://github.com/kotoba-lang/jp-go-digital-design-system"
         :git/sha "83db99546eabc53613ae826ea41d1533a3c574af"}
io.github.kotoba-lang/langgraph
        {:local/root "../../kotoba-lang/langgraph"}}
 :aliases
 {;; offline workspace dev — pin transitive langchain to local checkout
  :dev {:override-deps
        {io.github.kotoba-lang/langchain
         {:local/root "../../kotoba-lang/langchain"}}}
  ;; kbb -M:dev:run  → drive the demo through one OperationActor
  :run {:main-opts ["-m" "marketdata.sim"]}
  ;; kbb -M:dev:render-html → build-time docs/samples/operator-console.html
  :render-html {:main-opts ["-m" "marketdata.render-html"]}
  ;; http-kit/jsonista live ONLY here (not :deps) -- marketdata.feed's
  ;; live-fetch fns are JVM-only (#?(:clj ...)), same zero-dep-core
  ;; discipline as langchain.jvm (org.httpkit.client + jsonista.core,
  ;; only pulled in via langchain's own :test alias, never :deps).
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}
                      http-kit/http-kit {:mvn/version "2.8.0"}
                      metosin/jsonista  {:mvn/version "0.3.11"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; kbb -M:feed:dev:run-feed -- live smoke test against the real ECB/
  ;; EIA/FRED APIs and the direct crypto venues (needs EIA_API_KEY/
  ;; FRED_API_KEY for the first two; ECB and all four CEX venues need no
  ;; key; the Uniswap leg needs ETH_RPC_URL). Not run by :test -- see
  ;; docs/operator-guide.md.
  ;;
  ;; org-ethereum-jsonrpc lives HERE and not in :deps or :test on purpose:
  ;; only marketdata.feed-eth (the on-chain transport) needs it, nothing
  ;; under test/ requires that namespace, and CI's `kbb -M:dev:test`
  ;; job only checks out langgraph/langchain -- so the test path must not
  ;; depend on a third sibling checkout. The price math it would want to
  ;; test is pure and lives in marketdata.uniswap, which has no deps.
  :feed {:extra-deps {http-kit/http-kit {:mvn/version "2.8.0"}
                      metosin/jsonista  {:mvn/version "0.3.11"}
                      io.github.kotoba-lang/org-ethereum-jsonrpc
                      {:local/root "../../kotoba-lang/org-ethereum-jsonrpc"}}}
  :run-feed {:main-opts ["-m" "marketdata.feed-demo"]}
  ;; static analysis — clj-kondo from deps (no binary), errors fail CI.
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}}}
